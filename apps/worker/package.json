{
  "name": "@ricetext/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "deploy": "wrangler deploy --env production",
    "deploy:preview": "wrangler deploy --env preview",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
    "d1:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.1",
    "@ricetext/contracts": "workspace:^",
    "@ricetext/document-core": "workspace:^",
    "@ricetext/server-core": "workspace:^",
    "hono": "^4.12.8",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@msw/cloudflare": "^0.0.1",
    "wrangler": "^4.77.0"
  }
}
